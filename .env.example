# 2PIX 环境变量模板
# 复制本文件为 .env 并根据实际情况修改
# 注意：.env 文件不会被提交到 Git

# 服务器端口
PORT=3001

# 运行环境
NODE_ENV=development

# CORS 允许来源（生产环境必填，多个用逗号分隔）
# 示例：CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com
CORS_ORIGINS=

# JWT 密钥（生产环境必须修改！）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT 过期时间
JWT_EXPIRES_IN=7d

# 配置加密密钥（用于加密支付私钥等敏感配置，生产环境必须修改！）
CONFIG_ENCRYPTION_KEY=your-super-secret-config-encryption-key-change-this

# 默认管理员密码（仅在数据库初始化时生效）
ADMIN_DEFAULT_PASSWORD=admin123456

# 应用基础 URL（用于邮件链接等）
# 示例：APP_BASE_URL=https://your-domain.com
APP_BASE_URL=

# SMTP 邮件服务器配置（注册邮箱验证码需要）
# 不配置时开发环境会在接口响应中返回验证码，生产环境必须配置真实 SMTP
# 示例（QQ 邮箱）：SMTP_HOST=smtp.qq.com SMTP_PORT=587 SMTP_USER=your@qq.com SMTP_PASS=your_authorization_code
# 示例（阿里云）：SMTP_HOST=smtpdm.aliyun.com SMTP_PORT=465 SMTP_USER=noreply@your-domain.com SMTP_PASS=your_password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
