# 2PIX 环境变量模板
# 复制本文件为 .env 并根据实际情况修改
# 注意：.env 文件不会被提交到 Git

# 服务器端口
PORT=3001

# 运行环境
NODE_ENV=development

# CORS 允许来源（生产环境必填，多个用逗号分隔）
# 示例：CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com
CORS_ORIGINS=

# JWT 密钥（生产环境必须设置强密钥，不能为空，无 fallback 默认值）
JWT_SECRET=

# JWT 过期时间
JWT_EXPIRES_IN=7d

# 配置加密密钥（用于加密支付私钥等敏感配置，生产环境必须设置强密钥，不能为空，无 fallback 默认值）
CONFIG_ENCRYPTION_KEY=

# 默认管理员密码（仅在数据库初始化时生效，必须设置强密码）
ADMIN_DEFAULT_PASSWORD=

# 应用基础 URL（用于邮件链接等）
# 示例：APP_BASE_URL=https://your-domain.com
APP_BASE_URL=

# SMTP 邮件服务器配置（注册邮箱验证码需要）
# 不配置时开发环境会在接口响应中返回验证码，生产环境必须配置真实 SMTP
# 示例（QQ 邮箱）：SMTP_HOST=smtp.qq.com SMTP_PORT=587 SMTP_USER=your@qq.com SMTP_PASS=your_authorization_code
# 示例（阿里云）：SMTP_HOST=smtpdm.aliyun.com SMTP_PORT=465 SMTP_USER=noreply@your-domain.com SMTP_PASS=your_password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMTP TLS 证书校验开关（可选，默认开启）
# 设置为 false 可关闭 TLS 证书校验（仅用于本地/容器调试或证书链不完整的环境）
# 生产环境强烈建议保持开启（不设置或设置为 true）
SMTP_TLS_REJECT_UNAUTHORIZED=true

# ========== 上游价格自动同步配置 ==========
# kie.ai 价格接口地址（如果官方调整接口请修改此处）
KIE_PRICING_URL=https://api.kie.ai/client/v1/model-pricing/page

# 分页参数配置
KIE_PRICING_PAGE_PARAM=pageNum
KIE_PRICING_SIZE_PARAM=pageSize
KIE_PRICING_PAGE_SIZE=25
KIE_PRICING_MAX_PAGES=20

# 请求头（遇到区域限制或反爬时可调整）
# KIE_PRICING_USER_AGENT=Mozilla/5.0 ...
# KIE_PRICING_HEADERS=Cookie:xxx,Authorization:Bearer xxx

# 快照与映射文件路径（一般保持默认）
# KIE_PRICING_SNAPSHOT_PATH=/opt/2pix/data/kie_pricing_snapshot.json
# PRICING_MAPPING_PATH=/opt/2pix/pricing_mapping.json
